{
  "name": "osrbot-link-lite-desktop",
  "version": "0.2.0",
  "description": "OSRBOT Link Lite desktop client",
  "main": "src/main.js",
  "author": {
    "name": "OSRBOT"
  },
  "license": "MIT",
  "homepage": "https://github.com/osrbot/osrbot-link",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:rebuild": "electron-builder --config.buildDependenciesFromSource=true",
    "dist": "npm run dist:mac",
    "dist:mac": "BUILD_DATE=$(date +%Y%m%d) electron-builder --mac --x64 --arm64 --publish=never",
    "dist:win": "BUILD_DATE=$(date +%Y%m%d) electron-builder --win --x64 --publish=never",
    "dist:win:ia32": "BUILD_DATE=$(date +%Y%m%d) electron-builder --win --ia32 --publish=never",
    "dist:linux": "BUILD_DATE=$(date +%Y%m%d) electron-builder --linux --x64 --publish=never",
    "dist:all": "BUILD_DATE=$(date +%Y%m%d) electron-builder --mac --win --linux --x64 --arm64 --publish=never",
    "dist:rebuild": "electron-builder --publish=never --config.buildDependenciesFromSource=true",
    "build:native": "cd native/rdev-grabber && npm install && npm run build"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-hid": "^3.3.0",
    "socket.io": "^4.7.4",
    "ws": "^8.16.0"
  },
  "build": {
    "appId": "com.osrbot.link-lite",
    "productName": "OSRBOT Link Lite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "native/rdev-grabber/index.js",
      "native/rdev-grabber/index.d.ts",
      "native/rdev-grabber/package.json",
      "native/rdev-grabber/*.node",
      "!node_modules/.cache/**/*",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}"
    ],
    "asarUnpack": [
      "native/rdev-grabber/*.node"
    ],
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "assets/99-hidraw-permissions.rules",
        "to": "99-hidraw-permissions.rules"
      },
      {
        "from": "assets/post-install.sh",
        "to": "post-install.sh"
      }
    ],
    "mac": {
      "artifactName": "OSRBOT-Link-Lite-v0.2-${env.BUILD_DATE}-mac-${arch}.${ext}",
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": "assets/Info.plist"
    },
    "dmg": {
      "title": "OSRBOT Link Lite",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "artifactName": "OSRBOT-Link-Lite-v0.2-${env.BUILD_DATE}-win-${arch}.${ext}",
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "OSRBOT-Link-Lite-v0.2-${env.BUILD_DATE}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "artifactName": "OSRBOT-Link-Lite-v0.2-${env.BUILD_DATE}-ubuntu-${arch}.${ext}",
      "icon": "build/icons",
      "category": "Utility",
      "desktop": {
        "Name": "OSRBOT Link Lite",
        "Comment": "OSRBOT USB KVM Control Software",
        "Type": "Application",
        "Categories": "Utility;System;",
        "StartupNotify": "true"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libusb-1.0-0",
        "libudev1",
        "libc6"
      ],
      "afterInstall": "assets/post-install.sh",
      "maintainer": "OSRBOT",
      "synopsis": "OSRBOT Link Lite client for USB HID devices"
    }
  }
}
