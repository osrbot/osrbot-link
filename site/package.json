  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lucide/vue": "1.65.0",
    "cheerio": "1.1.2",
    "sharp": "0.35.5",
    "turndown": "7.2.1",
    "turndown-plugin-gfm": "1.0.2",
    "vitepress": "1.6.4"
  }
}
